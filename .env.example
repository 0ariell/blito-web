# Base de datos (Neon). Sin esto los formularios responden OK pero no guardan.
DATABASE_URL=

# URL pública del sitio (links de mails, webhooks, canonical).
SITE_URL=https://blito-producciones.onrender.com

# --- Venta de kits ---
# Access token de producción de Mercado Pago (Tus integraciones → Credenciales).
MP_ACCESS_TOKEN=
# Clave secreta del webhook (Tus integraciones → Webhooks). URL a configurar: $SITE_URL/api/mp/webhook
MP_WEBHOOK_SECRET=
# Cualquier texto largo y aleatorio: firma los links de descarga.
DOWNLOAD_TOKEN_SECRET=
# JSON con la URL privada del .zip de cada kit.
KIT_ARCHIVOS={"cabina-vol-1":"https://...","turreo-edits":"https://..."}

# --- Mails (Resend) ---
RESEND_API_KEY=
MAIL_FROM=Blito Producciones <hola@tudominio.com>
# A dónde llegan los avisos de demos y arrepentimientos.
NOTIFY_EMAIL=

# --- Legales ---
LEGAL_TITULAR=
LEGAL_CUIT=
LEGAL_EMAIL=

# --- Panel /admin ---
ADMIN_USER=blito
ADMIN_PASSWORD=
