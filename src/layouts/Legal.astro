---
import Base from './Base.astro';
interface Props { title: string; description: string; actualizado: string }
const { title, description, actualizado } = Astro.props;
---
<Base title={`${title} · Blito Producciones`} description={description}>
  <article class="sec lg">
    <div class="wrap lg__in">
      <h1 class="lg__t">{title}</h1>
      <p class="lg__upd">Última actualización: {actualizado}</p>
      <div class="lg__body"><slot /></div>
    </div>
  </article>
</Base>

<style>
  .lg { padding-top: 140px; }
  .lg__in { max-width: 820px; }
  .lg__t { margin: 0; font-size: clamp(2.6rem, 1.4rem + 4vw, 5rem); line-height: .9; font-weight: 900; font-variation-settings: 'wdth' 125; letter-spacing: -0.035em; overflow-wrap: anywhere; hyphens: auto; }
  .lg__upd { margin: 1rem 0 3rem; color: var(--mute); font-size: var(--step--1); }
  .lg__body :global(h2) { margin: 2.6rem 0 .8rem; font-size: var(--step-1); font-weight: 800; }
  .lg__body :global(p), .lg__body :global(li) { color: #d4d6ea; max-width: 68ch; line-height: 1.65; }
  .lg__body :global(ul) { padding-left: 1.2rem; }
  .lg__body :global(a) { color: var(--led-ink); }
</style>
