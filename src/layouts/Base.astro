---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string; description: string; image?: string }
const { title, description, image = '/video/hero-poster.jpg' } = Astro.props;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/logo-bp.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,300..900;1,62..125,300..900&display=swap" rel="stylesheet" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido"><slot /></main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    /* Negro de estudio y el azul de las tiras LED de las fotos. Sin modo claro: es la identidad. */
    --black: #000;
    --led: #2b30f2;          /* rellenos con texto blanco encima (7.5:1) */
    --led-ink: #8a8fff;      /* azul para texto sobre negro (7.4:1) */
    --led-soft: rgba(43, 48, 242, 0.14);
    --white: #fff;
    --mute: #a4a8c4;         /* texto secundario sobre negro (9:1) */
    --line: rgba(138, 143, 255, 0.2);
    --panel: rgba(138, 143, 255, 0.06);
    --rec: #ff3b2f;

    --gutter: clamp(16px, 4vw, 56px);
    --max: 1440px;
    --step--1: clamp(0.82rem, 0.8rem + 0.1vw, 0.9rem);
    --step-0: clamp(1rem, 0.96rem + 0.2vw, 1.125rem);
    --step-1: clamp(1.25rem, 1.1rem + 0.6vw, 1.6rem);
    --step-2: clamp(1.6rem, 1.3rem + 1.4vw, 2.6rem);
    --step-3: clamp(2.4rem, 1.5rem + 3.8vw, 5.2rem);
    --ease: cubic-bezier(.2, .7, .1, 1);
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 76px; -webkit-text-size-adjust: 100%; background: var(--black); }
  body {
    margin: 0; background: var(--black); color: var(--white);
    font-family: 'Archivo', system-ui, sans-serif; font-size: var(--step-0);
    font-variation-settings: 'wdth' 100; line-height: 1.5;
    -webkit-font-smoothing: antialiased; overflow-x: hidden;
  }
  img, video { display: block; max-width: 100%; height: auto; }
  a { color: inherit; }
  button { font: inherit; color: inherit; }
  :focus-visible { outline: 3px solid var(--led-ink); outline-offset: 3px; }
  ::selection { background: var(--led); color: #fff; }
  .wrap { width: 100%; max-width: var(--max); margin-inline: auto; padding-inline: var(--gutter); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .skip { position: absolute; left: 1rem; top: -4rem; z-index: 100; background: var(--led); padding: .7rem 1rem; border-radius: 8px; }
  .skip:focus { top: 1rem; }

  /* Tipografía de sección compartida */
  .sec { padding-block: clamp(4.5rem, 10vw, 9rem); }
  .sec-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem 2rem; margin-bottom: clamp(2rem, 4vw, 3.5rem); }
  .sec-title {
    margin: 0; font-size: var(--step-3); line-height: .88; font-weight: 900;
    font-variation-settings: 'wdth' 125; letter-spacing: -0.035em;
  }
  .sec-lead { margin: .8rem 0 0; max-width: 44ch; color: var(--mute); }

  /* Botones */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: .55em;
    min-height: 48px; padding: 0 1.4em; border: 0; border-radius: 999px; cursor: pointer;
    background: var(--led); color: #fff; text-decoration: none;
    font-weight: 700; font-variation-settings: 'wdth' 112;
    transition: background-color .18s, transform .18s var(--ease);
  }
  .btn:hover { background: #3d42ff; }
  .btn:active { transform: scale(.97); }
  .btn--ghost { background: transparent; box-shadow: inset 0 0 0 2px var(--line); }
  .btn--ghost:hover { background: var(--panel); box-shadow: inset 0 0 0 2px var(--led-ink); }
  .btn--white { background: #fff; color: #000; }
  .btn--white:hover { background: #dfe1ff; }
  .btn[disabled] { opacity: .6; cursor: progress; }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
</style>
