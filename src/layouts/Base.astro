---
import '@fontsource-variable/anybody/wdth.css';
import '@fontsource-variable/mona-sans/wdth.css';
import anybody from '@fontsource-variable/anybody/files/anybody-latin-wdth-normal.woff2?url';
import mona from '@fontsource-variable/mona-sans/files/mona-sans-latin-wdth-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { marca, contacto } from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  jsonld?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description, image = '/og.jpg', noindex = false, jsonld } = Astro.props;
const preloadFont = true;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
const ogImage = new URL(image, Astro.site);
const org = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  '@id': new URL('/#org', Astro.site).href,
  name: marca.nombre,
  alternateName: 'Blito RMX',
  url: Astro.site?.href,
  logo: new URL('/icon-512.png', Astro.site).href,
  genre: ['RKT', 'Trap', 'Turreo'],
  foundingLocation: { '@type': 'Place', name: 'Buenos Aires, Argentina' },
  sameAs: [contacto.igSello, contacto.igBlito, contacto.youtube],
};
const schemas = [org, ...(jsonld ? [jsonld].flat() : [])];
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={marca.nombre} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {preloadFont && <link rel="preload" href={anybody} as="font" type="font/woff2" crossorigin />}
    {preloadFont && <link rel="preload" href={mona} as="font" type="font/woff2" crossorigin />}
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido"><slot /></main>
    <Footer />
    <a href="#contenido" class="totop" data-totop aria-label="Volver arriba" hidden>
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M12 19V5M5.5 11.5L12 5l6.5 6.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
    <script>
      const top = document.querySelector<HTMLAnchorElement>('[data-totop]')!;
      top.hidden = false;
      const sync = () => top.classList.toggle('is-on', scrollY > innerHeight * 0.9);
      sync();
      addEventListener('scroll', sync, { passive: true });
      top.addEventListener('click', (e) => {
        e.preventDefault();
        scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
        (document.querySelector('.hd a') as HTMLElement | null)?.focus({ preventScroll: true });
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    /* Negro de estudio y el azul de las tiras LED de las fotos. Sin modo claro: es la identidad. */
    --black: #000;
    --led: #2b30f2;          /* rellenos con texto blanco encima (7.5:1) */
    --led-ink: #8a8fff;      /* azul para texto sobre negro (7.4:1) */
    --led-soft: rgba(43, 48, 242, 0.14);
    --white: #fff;
    --mute: #a4a8c4;         /* texto secundario sobre negro (9:1) */
    --line: rgba(138, 143, 255, 0.2);
    --panel: rgba(138, 143, 255, 0.06);
    --rec: #ff3b2f;

    --gutter: clamp(16px, 4vw, 56px);
    --max: 1440px;
    --step--1: clamp(0.82rem, 0.8rem + 0.1vw, 0.9rem);
    --step-0: clamp(1rem, 0.96rem + 0.2vw, 1.125rem);
    --step-1: clamp(1.25rem, 1.1rem + 0.6vw, 1.6rem);
    --step-2: clamp(1.6rem, 1.3rem + 1.4vw, 2.6rem);
    --step-3: clamp(2.4rem, 1.5rem + 3.8vw, 5.2rem);
    --ease: cubic-bezier(.2, .7, .1, 1);
    /* Anybody: títulos y marca (eje de ancho 50 a 150). Mona Sans: texto. */
    --display: 'Anybody Variable', 'Arial Black', system-ui, sans-serif;
    --text: 'Mona Sans Variable', system-ui, -apple-system, 'Segoe UI', sans-serif;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 76px; -webkit-text-size-adjust: 100%; background: var(--black); }
  body {
    margin: 0; background: var(--black); color: var(--white);
    font-family: var(--text); font-size: var(--step-0);
    font-variation-settings: 'wdth' 100; line-height: 1.5;
    -webkit-font-smoothing: antialiased; overflow-x: hidden;
    touch-action: manipulation; -webkit-tap-highlight-color: transparent;
  }
  h1, h2, h3 { text-wrap: balance; }
  p, dd, li { text-wrap: pretty; }
  @media (pointer: fine) { html { overscroll-behavior: none; } }
  img, video { display: block; max-width: 100%; height: auto; }
  a { color: inherit; }
  button { font: inherit; color: inherit; }
  :focus-visible { outline: 3px solid var(--led-ink); outline-offset: 3px; }
  ::selection { background: var(--led); color: #fff; }
  .wrap { width: 100%; max-width: var(--max); margin-inline: auto; padding-inline: max(var(--gutter), env(safe-area-inset-left)) max(var(--gutter), env(safe-area-inset-right)); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .skip { position: absolute; left: 1rem; top: -4rem; z-index: 100; background: var(--led); padding: .7rem 1rem; border-radius: 8px; }
  .skip:focus { top: 1rem; }

  /* Tipografía de sección compartida */
  .sec { padding-block: clamp(4.5rem, 10vw, 9rem); }
  /* Primera sección de cada página: deja lugar para el header fijo */
  main > section.sec:first-child { padding-top: clamp(124px, 14vw, 168px); }
  .sec-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem 2rem; margin-bottom: clamp(2rem, 4vw, 3.5rem); }
  .sec-title {
    margin: 0; font-size: var(--step-3); line-height: .9; font-weight: 900;
    font-family: var(--display); font-variation-settings: 'wdth' 125; letter-spacing: -0.035em;
  }
  @media (max-width: 1100px) { .sec-title { font-variation-settings: 'wdth' 110; } }
  @media (max-width: 600px) { .sec-title { font-variation-settings: 'wdth' 100; font-size: clamp(2.1rem, 10.5vw, 3.2rem); } }
  .sec-lead { margin: .8rem 0 0; max-width: 44ch; color: var(--mute); }

  /* Formularios */
  .form { display: grid; gap: 1.4rem; align-content: start; }
  .field { display: grid; gap: .45rem; }
  .field label { font-weight: 700; }
  .opt { font-weight: 400; color: var(--mute); }
  .field input, .field textarea {
    width: 100%; font: inherit; color: #fff; background: var(--panel);
    border: 1px solid var(--line); border-radius: 12px; padding: .85rem 1rem; min-height: 50px;
    transition: border-color .15s, box-shadow .15s;
  }
  .field input::placeholder, .field textarea::placeholder { color: #8c90ad; }
  .field input:focus, .field textarea:focus { outline: none; border-color: var(--led-ink); box-shadow: 0 0 0 3px var(--led-soft); }
  .field input[aria-invalid='true'] { border-color: #ff6b61; }
  .field__hint { margin: 0; font-size: var(--step--1); color: var(--mute); }
  .field__err { margin: 0; font-size: var(--step--1); color: #ff8a82; font-weight: 600; }
  .field__err:empty { display: none; }
  .form .btn { justify-self: start; }
  .form__status { margin: 0; font-weight: 700; color: var(--led-ink); }
  .form__status:empty { display: none; }

  /* Campo trampa para bots: invisible para personas y lectores de pantalla */
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  /* Volver arriba */
  .totop {
    position: fixed; z-index: 35; right: max(1rem, env(safe-area-inset-right)); bottom: calc(1rem + env(safe-area-inset-bottom));
    display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%;
    background: rgba(10, 12, 40, .78); color: #fff; backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    box-shadow: inset 0 0 0 1px rgba(138,143,255,.4), 0 10px 30px rgba(43,48,242,.35);
    opacity: 0; transform: translateY(12px) scale(.9); pointer-events: none; transition: opacity .25s, transform .25s var(--ease), background-color .2s;
  }
  .totop.is-on { opacity: 1; transform: none; pointer-events: auto; }
  .totop:hover { background: var(--led); }
  body:has(.kd__sticky.is-on) .totop { bottom: calc(5.4rem + env(safe-area-inset-bottom)); }
  body:has(dialog[open]) .totop { display: none; }

  /* Botones */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: .55em;
    min-height: 48px; padding: 0 1.4em; border: 0; border-radius: 999px; cursor: pointer;
    background: var(--led); color: #fff; text-decoration: none;
    font-weight: 700; font-variation-settings: 'wdth' 112;
    transition: background-color .18s, transform .18s var(--ease);
  }
  .btn:hover { background: #3d42ff; }
  .btn:active { transform: scale(.97); }
  .btn--ghost { background: transparent; box-shadow: inset 0 0 0 2px var(--line); }
  .btn--ghost:hover { background: var(--panel); box-shadow: inset 0 0 0 2px var(--led-ink); }
  .btn--white { background: #fff; color: #000; }
  .btn--white:hover { background: #dfe1ff; }
  .btn[disabled] { opacity: .6; cursor: progress; }

  /* Transiciones nativas entre páginas (MPA), sin JavaScript. */
  @view-transition { navigation: auto; }
  ::view-transition-old(root) { animation: vt-out .18s ease both; }
  ::view-transition-new(root) { animation: vt-in .28s var(--ease) both; }
  @keyframes vt-out { to { opacity: 0; } }
  @keyframes vt-in { from { opacity: 0; transform: translateY(6px); } }
  .hd { view-transition-name: header; }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    @view-transition { navigation: none; }
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
</style>
