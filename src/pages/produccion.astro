---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { produccion, intereses, lanzamientos, waLink } from '../data/site';
import { img } from '../lib/img';
const { servicios, mensualidad, proceso, faq } = produccion;
const creditos = lanzamientos.filter((l) => l.tipo === 'produccion').slice(0, 3);
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Producción musical',
  provider: { '@id': new URL('/#org', Astro.site).href },
  areaServed: 'AR',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios de producción',
    itemListElement: [...servicios.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.titulo, description: s.texto } })),
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: mensualidad.titulo, description: mensualidad.bajada } }],
  },
};
---
<Base title="Producción musical con Blito: beats, mezcla y mensualidad" description="Beats a medida, producción completa, mezcla y una mensualidad con acompañamiento personalizado de Blito. Contanos tu idea." jsonld={jsonld}>
  <section class="ph">
    <div class="ph__bg" aria-hidden="true">
      <Image src={img('estudio-azul.jpg')} alt="" widths={[640, 1200]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="wrap ph__in">
      <h1 class="ph__t">Producción</h1>
      <p class="ph__lead">Tu tema, hecho en serio. Beats a medida, grabación, mezcla y un acompañamiento mensual para crecer con un plan.</p>
      <div class="ph__actions">
        <a class="btn btn--white" href="#contacto">Contanos tu idea</a>
        <a class="btn btn--ghost" href="#mensualidad">Ver la mensualidad</a>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="srv-t">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <h2 id="srv-t" class="sec-title">Qué hacemos</h2>
          <p class="sec-lead">Elegí por dónde arrancar. Si no sabés, contanos la idea y te recomendamos.</p>
        </div>
      </div>
      <ul class="srv" role="list">
        {servicios.map((s) => (
          <li class="srv__item">
            <h3 class="srv__t">{s.titulo}</h3>
            <p class="srv__p">{s.texto}</p>
            <ul class="srv__inc" role="list">{s.incluye.map((i) => <li>{i}</li>)}</ul>
            <a class="srv__cta" href={`?interes=${s.id}#contacto`} data-interes={s.id}>Consultar por {s.titulo.toLowerCase()}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="mensualidad" class="sec mz" aria-labelledby="mz-t">
    <div class="wrap mz__grid">
      <div class="mz__card">
        <p class="mz__tag">Plan mes a mes</p>
        <h2 id="mz-t" class="mz__t">{mensualidad.titulo}</h2>
        <p class="mz__lead">{mensualidad.bajada}</p>
        <ul class="mz__list" role="list">
          {mensualidad.incluye.map((i) => (
            <li><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>{i}</li>
          ))}
        </ul>
        <div class="mz__foot">
          <p class="mz__price">Valor según tu plan. Te lo pasamos con la propuesta.</p>
          <a class="btn mz__cta" href="?interes=mensualidad#contacto" data-interes="mensualidad">Quiero la mensualidad</a>
        </div>
      </div>
      <div class="mz__side">
        <Image src={img('estudio-rojo.jpg')} alt="El escritorio del estudio con luz roja." widths={[480, 800]} sizes="(min-width: 900px) 34vw, 100vw" loading="lazy" />
        <h3 class="mz__h3">Para quién es</h3>
        <ul class="mz__para" role="list">{mensualidad.para.map((p) => <li>{p}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="pr-t">
    <div class="wrap">
      <h2 id="pr-t" class="sec-title">Cómo trabajamos</h2>
      <ol class="steps" role="list">
        {proceso.map((p, i) => (
          <li><span class="steps__n" aria-hidden="true">{i + 1}</span><h3>{p.titulo}</h3><p>{p.texto}</p></li>
        ))}
      </ol>
    </div>
  </section>

  {creditos.length > 0 && (
    <section class="sec cr" aria-labelledby="cr-t">
      <div class="wrap">
        <div class="sec-head">
          <h2 id="cr-t" class="sec-title">Salió del estudio</h2>
          <a class="btn btn--ghost" href="/lanzamientos">Ver todos los lanzamientos</a>
        </div>
        <ul class="cr__grid" role="list">
          {creditos.map((l) => (
            <li>
              <a class="cr__item" href={`https://www.youtube.com/watch?v=${l.youtube}`} target="_blank" rel="noopener">
                <Image src={img(l.img)} alt="" widths={[480, 720]} sizes="(min-width: 900px) 30vw, 90vw" loading="lazy" />
                <span class="cr__t" translate="no">{l.tema}</span>
                <span class="cr__a">{l.artistas}<span class="visually-hidden"> (abre YouTube)</span></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section id="contacto" class="sec ct" aria-labelledby="ct-t">
    <div class="wrap ct__grid">
      <div>
        <h2 id="ct-t" class="ct__t">Contanos tu idea</h2>
        <p class="ct__lead">Mandanos lo que tengas: una maqueta, una referencia o solo la idea. Blito lo escucha y te escribe con una propuesta.</p>
        <div class="ct__direct">
          <p>¿Preferís hablar directo?</p>
          <a href={waLink('Hola Blito, quiero consultar por producción.')} target="_blank" rel="noopener">Escribir por WhatsApp</a>
        </div>
      </div>
      <form class="form" method="post" action="/api/consulta" novalidate data-consulta>
        <fieldset class="field ct__interes">
          <legend>¿Qué estás buscando?</legend>
          <div class="ct__opts">
            {intereses.map((i, n) => (
              <label class="opt-pill">
                <input type="radio" name="interes" value={i.id} required checked={n === 0} />
                <span>{i.label}</span>
              </label>
            ))}
          </div>
          <p class="field__err" id="ce-interes"></p>
        </fieldset>
        <div class="ct__row">
          <div class="field">
            <label for="c-nombre">Nombre o nombre artístico</label>
            <input id="c-nombre" name="nombre" autocomplete="name" required />
            <p class="field__err" id="ce-nombre"></p>
          </div>
          <div class="field">
            <label for="c-ig">Instagram <span class="opt">(opcional)</span></label>
            <input id="c-ig" name="instagram" autocomplete="off" spellcheck="false" placeholder="@tuusuario" />
          </div>
        </div>
        <div class="ct__row">
          <div class="field">
            <label for="c-email">Mail</label>
            <input id="c-email" name="email" type="email" autocomplete="email" spellcheck="false" required />
            <p class="field__err" id="ce-email"></p>
          </div>
          <div class="field">
            <label for="c-wa">WhatsApp <span class="opt">(opcional)</span></label>
            <input id="c-wa" name="whatsapp" type="tel" inputmode="tel" autocomplete="tel" placeholder="11 1234-5678" />
          </div>
        </div>
        <div class="field">
          <label for="c-idea">Tu idea</label>
          <textarea id="c-idea" name="idea" rows="5" required aria-describedby="c-idea-h" placeholder="Qué querés hacer, en qué género, si ya tenés letra o maqueta…"></textarea>
          <p class="field__hint" id="c-idea-h">No hace falta que esté todo claro. Con contarnos la idea alcanza.</p>
          <p class="field__err" id="ce-idea"></p>
        </div>
        <div class="field">
          <label for="c-ref">Links de referencia <span class="opt">(opcional)</span></label>
          <input id="c-ref" name="referencias" autocomplete="off" spellcheck="false" placeholder="Un tema que te guste, tu maqueta en Drive…" />
        </div>
        <div class="hp" aria-hidden="true"><label>Web <input name="web" tabindex="-1" autocomplete="off" /></label></div>
        <button class="btn btn--big" type="submit">Enviar consulta</button>
        <div class="ct__ok" role="status" aria-live="polite" tabindex="-1"></div>
      </form>
    </div>
  </section>

  <section class="sec" aria-labelledby="pf-t">
    <div class="wrap faq-wrap">
      <h2 id="pf-t" class="sec-title">Preguntas</h2>
      <div class="faq">
        {faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </div>
    </div>
  </section>
</Base>

<style>
  .ph { position: relative; min-height: 78svh; display: grid; align-items: end; overflow: hidden; isolation: isolate; padding-block: 140px clamp(3rem, 7vw, 6rem); }
  .ph__bg { position: absolute; inset: 0; z-index: -1; }
  .ph__bg img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; opacity: .55; }
  .ph__bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, #000 8%, rgba(0,0,0,.55) 55%, rgba(0,0,0,.75)); }
  .ph__t { margin: 0; font-family: var(--display); font-variation-settings: 'wdth' 130; font-weight: 900; font-size: clamp(2.6rem, 11vw, 11rem); line-height: .82; letter-spacing: -0.045em; }
  .ph__lead { margin: 1.4rem 0 0; max-width: 40ch; font-size: var(--step-1); line-height: 1.35; color: #d4d6ea; }
  .ph__actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.8rem; }

  .srv { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1rem, 2vw, 1.5rem); }
  .srv__item { display: flex; flex-direction: column; padding: clamp(1.4rem, 2.4vw, 2rem); border-radius: 18px; background: var(--panel); box-shadow: inset 0 0 0 1px var(--line); }
  .srv__t { margin: 0; font-family: var(--display); font-variation-settings: 'wdth' 112; font-weight: 800; font-size: var(--step-1); }
  .srv__p { margin: .8rem 0 1rem; color: var(--mute); }
  .srv__inc { list-style: none; margin: 0 0 1.4rem; padding: 0; display: grid; gap: .4rem; }
  .srv__inc li { display: flex; gap: .6rem; align-items: baseline; }
  .srv__inc li::before { content: ''; flex: none; width: .45rem; height: .45rem; border-radius: 50%; background: var(--led-ink); translate: 0 -.1rem; }
  .srv__cta { margin-top: auto; align-self: start; color: var(--led-ink); font-weight: 700; text-underline-offset: .25em; padding-block: .5rem; }

  .mz { background: radial-gradient(70% 70% at 30% 40%, rgba(43,48,242,.22), transparent 70%); }
  .mz__grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr); gap: clamp(1.5rem, 4vw, 4rem); align-items: start; }
  .mz__card { padding: clamp(1.6rem, 4vw, 3.2rem); border-radius: 24px; background: linear-gradient(160deg, #10125a, #050616 60%); box-shadow: inset 0 0 0 1px rgba(138,143,255,.35), 0 40px 120px -40px rgba(43,48,242,.7); }
  .mz__tag { display: inline-block; margin: 0 0 1.2rem; padding: .3rem .8rem; border-radius: 999px; background: rgba(255,255,255,.1); font-size: var(--step--1); font-weight: 700; }
  .mz__t { margin: 0; font-family: var(--display); font-variation-settings: 'wdth' 110; font-weight: 900; font-size: clamp(2rem, 1rem + 3.4vw, 4.2rem); line-height: .9; letter-spacing: -0.035em; }
  .mz__lead { margin: 1rem 0 1.6rem; font-size: var(--step-1); line-height: 1.35; color: #d4d6ea; max-width: 40ch; }
  .mz__list { list-style: none; margin: 0; padding: 0; display: grid; gap: .9rem; }
  .mz__list li { display: flex; gap: .8rem; align-items: flex-start; }
  .mz__list svg { flex: none; color: var(--led-ink); margin-top: .15rem; }
  .mz__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; margin-top: 2rem; padding-top: 1.6rem; border-top: 1px solid rgba(138,143,255,.25); }
  .mz__price { margin: 0; color: var(--mute); max-width: 30ch; }
  .mz__cta { min-height: 54px; }
  .mz__side img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 18px; }
  .mz__h3 { margin: 1.6rem 0 .6rem; font-family: var(--display); font-variation-settings: 'wdth' 112; font-size: var(--step-1); }
  .mz__para { margin: 0; padding-left: 1.1rem; color: var(--mute); display: grid; gap: .5rem; }

  .steps { list-style: none; margin: clamp(2rem, 4vw, 3rem) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1rem, 3vw, 3rem); counter-reset: s; }
  .steps li { border-top: 2px solid var(--led); padding-top: 1.2rem; }
  .steps__n { font-family: var(--display); font-variation-settings: 'wdth' 150; font-weight: 900; font-size: 3rem; line-height: 1; color: transparent; -webkit-text-stroke: 1.5px var(--led-ink); }
  .steps h3 { margin: .8rem 0 .4rem; font-size: var(--step-1); }
  .steps p { margin: 0; color: var(--mute); }

  .cr__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(.8rem, 1.6vw, 1.4rem); }
  .cr__item { display: grid; gap: .3rem; text-decoration: none; }
  .cr__item img { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 12px; margin-bottom: .5rem; transition: transform .4s var(--ease); }
  .cr__item:hover img { transform: scale(1.02); }
  .cr__t { font-weight: 800; }
  .cr__a { color: var(--mute); font-size: var(--step--1); }

  .ct { border-top: 1px solid var(--line); }
  .ct__grid { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(2rem, 6vw, 6rem); }
  .ct__t { margin: 0; font-family: var(--display); font-variation-settings: 'wdth' 100; font-weight: 900; font-size: clamp(2.4rem, 1rem + 3.6vw, 4.6rem); line-height: .9; letter-spacing: -0.035em; }
  .ct__lead { margin: 1.4rem 0 0; color: var(--mute); font-size: var(--step-1); line-height: 1.35; max-width: 32ch; }
  .ct__direct { margin-top: 2rem; }
  .ct__direct p { margin: 0 0 .3rem; font-weight: 700; color: var(--led-ink); }
  .ct__direct a { font-weight: 600; text-underline-offset: .25em; }
  .ct__row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem; }
  .ct__interes { border: 0; padding: 0; margin: 0; }
  .ct__interes legend { font-weight: 700; margin-bottom: .6rem; padding: 0; }
  .ct__opts { display: flex; flex-wrap: wrap; gap: .5rem; }
  .opt-pill { position: relative; cursor: pointer; }
  .opt-pill input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .opt-pill span { display: inline-flex; align-items: center; min-height: 44px; padding: 0 1rem; border-radius: 999px; box-shadow: inset 0 0 0 1px var(--line); color: var(--mute); font-weight: 600; transition: background-color .15s, color .15s, box-shadow .15s; }
  .opt-pill:hover span { color: #fff; box-shadow: inset 0 0 0 1px var(--led-ink); }
  .opt-pill input:checked + span { background: var(--led); color: #fff; box-shadow: none; }
  .opt-pill input:focus-visible + span { outline: 3px solid var(--led-ink); outline-offset: 3px; }
  .btn--big { min-height: 56px; padding-inline: 2rem; font-size: var(--step-1); justify-self: start; }
  .ct__ok:empty { display: none; }
  .ct__ok { padding: 1.4rem; border-radius: 16px; background: var(--led-soft); box-shadow: inset 0 0 0 1px var(--led-ink); }
  .ct__ok :global(h3) { margin: 0 0 .4rem; font-family: var(--display); font-variation-settings: 'wdth' 112; font-size: var(--step-1); }
  .ct__ok :global(p) { margin: 0; color: #d4d6ea; }

  .faq-wrap { display: grid; gap: 1.6rem; max-width: 900px; }
  .faq details { border-bottom: 1px solid var(--line); }
  .faq summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 1rem; min-height: 60px; font-weight: 700; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; font-size: 1.5rem; font-weight: 400; color: var(--led-ink); transition: transform .2s; }
  .faq details[open] summary::after { transform: rotate(45deg); }
  .faq p { margin: 0 0 1.3rem; color: var(--mute); max-width: 60ch; }

  @media (max-width: 900px) {
    .srv, .steps, .cr__grid, .mz__grid, .ct__grid { grid-template-columns: minmax(0, 1fr); }
    .ct__row { grid-template-columns: minmax(0, 1fr); }
    .mz__side img { aspect-ratio: 16 / 10; }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-consulta]')!;
  const ok = form.querySelector<HTMLElement>('.ct__ok')!;
  const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;

  // Preseleccionar el interés desde los botones de servicios (?interes=beat#contacto)
  const elegir = (id: string | null) => {
    const r = id && form.querySelector<HTMLInputElement>(`input[name=interes][value="${id}"]`);
    if (r) r.checked = true;
  };
  elegir(new URL(location.href).searchParams.get('interes'));
  document.querySelectorAll<HTMLAnchorElement>('[data-interes]').forEach((a) =>
    a.addEventListener('click', () => elegir(a.dataset.interes!)));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    form.querySelectorAll('.field__err').forEach((el) => (el.textContent = ''));
    form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
    ok.textContent = '';
    btn.disabled = true; btn.textContent = 'Enviando…';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      const data = await res.json();
      if (data.ok) {
        form.querySelectorAll('.field, .ct__row, button[type=submit]').forEach((el) => ((el as HTMLElement).hidden = true));
        const h = document.createElement('h3'); h.textContent = '¡Listo! Recibimos tu consulta.';
        const p = document.createElement('p'); p.textContent = 'Blito la va a escuchar y te escribe con una propuesta. Te mandamos una copia por mail.';
        ok.replaceChildren(h, p); ok.focus();
        return;
      }
      let first: HTMLElement | null = null;
      for (const [k, msg] of Object.entries<string>(data.errors ?? {})) {
        document.getElementById(`ce-${k}`)!.textContent = msg;
        const input = form.querySelector<HTMLElement>(`[name=${k}]`);
        input?.setAttribute('aria-invalid', 'true');
        first ??= input;
      }
      if (data.error) ok.textContent = data.error;
      first?.focus();
    } catch {
      ok.textContent = 'No se pudo enviar. Revisá tu conexión y probá de nuevo, o escribinos por WhatsApp.';
    } finally {
      btn.disabled = false; btn.textContent = 'Enviar consulta';
    }
  });
</script>
