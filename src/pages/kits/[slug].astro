---
import Base from '../../layouts/Base.astro';
import KitCover from '../../components/KitCover.astro';
import { kits, totalSonidos, ars } from '../../data/site';
import { ventaHabilitada } from '../../lib/env';

// Se renderiza en el servidor: el botón de compra depende de que el cobro esté configurado.
export const prerender = false;
const kit = kits.find((k) => k.slug === Astro.params.slug);
if (!kit) return Astro.rewrite('/404');
const vendible = kit.estado === 'venta' && ventaHabilitada(kit.slug);
const error = Astro.url.searchParams.get('error');
const url = new URL(`/kits/${kit.slug}`, Astro.site).href;
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: `${kit.nombre} Vol. ${Number(kit.vol)}`,
    description: kit.descripcion,
    category: 'Drum kit',
    image: new URL('/og.jpg', Astro.site).href,
    brand: { '@type': 'Brand', name: 'Blito Producciones' },
    offers: {
      '@type': 'Offer',
      url,
      price: kit.precioArs,
      priceCurrency: 'ARS',
      availability: vendible ? 'https://schema.org/InStock' : 'https://schema.org/PreOrder',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Drum kits', item: new URL('/kits', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: `${kit.nombre} Vol. ${Number(kit.vol)}`, item: url },
    ],
  },
];
const otros = kits.filter((k) => k.slug !== kit.slug);
const faq = [
  { q: '¿Cómo lo recibo?', a: 'Después de pagar te llega un mail con el link de descarga. El archivo es un .zip con todos los sonidos en WAV.' },
  { q: '¿Puedo usarlo en temas que publico?', a: 'Sí. Podés usar los sonidos en tus temas, comerciales o no, sin pagar regalías. Lo que no podés es revender los sonidos sueltos o en otro kit.' },
  { q: '¿Sirve para FL Studio, Ableton o cualquier DAW?', a: 'Sí. Son archivos WAV, funcionan en cualquier programa.' },
  { q: '¿Me puedo arrepentir de la compra?', a: 'Tenés 10 días corridos desde la compra para pedirlo con el Botón de arrepentimiento, al pie de cualquier página. Te respondemos con un código de trámite.' },
];
---
<Base title={`${kit.nombre} Vol. ${Number(kit.vol)}: drum kit de Blito`} description={kit.bajada} jsonld={jsonld}>
  <article class="sec kd">
    <div class="wrap">
      <a href="/kits" class="kd__back">Todos los kits</a>
      <div class="kd__grid">
        <div class="kd__cover"><KitCover kit={kit} size="lg" /></div>
        <div>
          <p class="kd__genres">{kit.generos.join(', ')}</p>
          <h1 class="kd__name">{kit.nombre} <span>Vol. {Number(kit.vol)}</span></h1>
          <p class="kd__lead">{kit.bajada}</p>
          <p class="kd__desc">{kit.descripcion}</p>

          <div class="kd__buy" id="comprar">
            <p class="kd__price"><strong>{ars(kit.precioArs)}</strong> <span>pago único en pesos</span></p>
            {vendible ? (
              <form class="kd__form" method="post" action="/api/checkout" data-checkout>
                <input type="hidden" name="kit" value={kit.slug} />
                <label class="kd__label" for="buy-email">Tu mail</label>
                <input id="buy-email" class="kd__input" name="email" type="email" required autocomplete="email" placeholder="tu@mail.com" aria-describedby="buy-help" spellcheck="false" />
                <p class="kd__help" id="buy-help">Ahí te llega el link de descarga apenas se acredita el pago.</p>
                <label class="kd__check">
                  <input type="checkbox" name="acepta" required />
                  <span>Acepto los <a href="/legales/terminos">términos y condiciones</a>.</span>
                </label>
                {error && <p class="kd__err" role="alert">{error}</p>}
                <button class="btn kd__cta" type="submit">Pagar con Mercado Pago</button>
                <p class="kd__secure">Pagás en Mercado Pago con tarjeta, débito o dinero en cuenta. Nosotros no vemos tus datos de pago.</p>
              </form>
            ) : (
              <form class="kd__wait" method="post" action="/api/suscribir" data-subscribe data-ok-msg="Listo. Te escribimos el día que salga a la venta.">
                <p class="kd__waittxt"><span class="kd__badge">{kit.estado === 'venta' ? 'Preventa' : 'Próximamente'}</span> Dejá tu mail y te avisamos el día que salga a la venta.</p>
                <div class="kd__row">
                  <label class="visually-hidden" for="kit-email">Tu mail para el aviso</label>
                  <input id="kit-email" name="email" type="email" required autocomplete="email" placeholder="tu@mail.com" spellcheck="false" />
                  <input type="hidden" name="origen" value={`kit:${kit.slug}`} />
                  <button class="btn" type="submit">Avisame</button>
                </div>
                <p class="kd__status" role="status" aria-live="polite"></p>
              </form>
            )}
          </div>

          <h2 class="kd__h2">Qué trae</h2>
          <ul class="kd__list" role="list">
            {kit.contenido.map((c) => <li><span>{c.item}</span><span>{c.cantidad}</span></li>)}
            <li class="kd__total"><span>Total</span><span>{totalSonidos(kit)} sonidos en WAV</span></li>
          </ul>

          <h2 class="kd__h2">Preguntas</h2>
          <div class="kd__faq">
            {faq.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </div>

      <h2 class="kd__h2 kd__more">Otros kits</h2>
      <ul class="kd__others" role="list">
        {otros.map((k) => (
          <li><a href={`/kits/${k.slug}`}><KitCover kit={k} /><span>{k.nombre} Vol. {Number(k.vol)}</span></a></li>
        ))}
      </ul>
    </div>
  </article>
</Base>

<style>
  .kd { padding-top: 120px; }
  .kd__back { display: inline-flex; min-height: 44px; align-items: center; color: var(--mute); text-decoration: none; font-weight: 600; margin-bottom: 1.5rem; }
  .kd__back::before { content: ''; width: .5em; height: .5em; border-left: 2px solid; border-bottom: 2px solid; transform: rotate(45deg); margin-right: .6em; }
  .kd__back:hover { color: #fff; }
  .kd__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .kd__cover { position: sticky; top: 100px; }
  .kd__genres { margin: 0 0 .8rem; color: var(--led-ink); font-weight: 700; }
  .kd__name { margin: 0; font-size: clamp(3rem, 1.4rem + 5vw, 6.5rem); line-height: .84; font-weight: 900; font-variation-settings: 'wdth' 125; letter-spacing: -0.045em; }
  .kd__name span { display: block; color: transparent; -webkit-text-stroke: 1.5px #fff; }
  .kd__lead { margin: 1.4rem 0 .6rem; font-size: var(--step-1); font-weight: 600; line-height: 1.3; }
  .kd__desc { margin: 0; color: var(--mute); max-width: 52ch; }
  .kd__buy { margin-top: 2rem; padding: 1.5rem; border-radius: 18px; background: var(--panel); box-shadow: inset 0 0 0 1px var(--line); }
  .kd__price { margin: 0 0 1rem; }
  .kd__price strong { font-size: var(--step-3); font-weight: 900; font-variation-settings: 'wdth' 110; letter-spacing: -0.03em; }
  .kd__price span { color: var(--mute); margin-left: .4rem; }
  .kd__cta { width: 100%; min-height: 56px; font-size: var(--step-1); margin-top: .4rem; }
  .kd__form { display: grid; gap: .6rem; }
  .kd__label { font-weight: 700; }
  .kd__input { min-height: 52px; padding: 0 1.1rem; border-radius: 12px; background: #000; border: 1px solid var(--line); color: #fff; font: inherit; }
  .kd__input:focus { outline: none; border-color: var(--led-ink); box-shadow: 0 0 0 3px var(--led-soft); }
  .kd__help, .kd__secure { margin: 0; font-size: var(--step--1); color: var(--mute); }
  .kd__check { display: flex; gap: .7rem; align-items: center; min-height: 44px; cursor: pointer; }
  .kd__check input { width: 20px; height: 20px; accent-color: var(--led); flex: none; }
  .kd__check a { color: var(--led-ink); }
  .kd__err { margin: 0; padding: .7rem .9rem; border-radius: 10px; background: rgba(255,90,80,.12); color: #ff9b94; font-weight: 600; }
  .kd__badge { display: inline-block; margin-right: .4rem; padding: .15rem .6rem; border-radius: 999px; background: var(--led-soft); color: var(--led-ink); font-weight: 700; font-size: var(--step--1); }
  .kd__waittxt { margin: 0 0 .9rem; color: var(--mute); }
  .kd__row { display: flex; gap: .6rem; }
  .kd__row input { flex: 1; min-width: 0; min-height: 50px; padding: 0 1.1rem; border-radius: 999px; background: #000; border: 1px solid var(--line); color: #fff; font: inherit; }
  .kd__row input:focus { outline: none; border-color: var(--led-ink); }
  .kd__status { margin: .8rem 0 0; font-weight: 600; color: var(--led-ink); }
  .kd__status:empty { display: none; }
  .kd__h2 { margin: 2.8rem 0 1rem; font-size: var(--step-1); font-weight: 900; font-variation-settings: 'wdth' 112; }
  .kd__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .kd__list li { display: flex; justify-content: space-between; gap: 1rem; padding: .75rem 0; border-bottom: 1px solid var(--line); }
  .kd__list li span:last-child { font-weight: 700; font-variant-numeric: tabular-nums; }
  .kd__total { color: var(--led-ink); }
  .kd__faq details { border-bottom: 1px solid var(--line); }
  .kd__faq summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 1rem; min-height: 56px; font-weight: 700; }
  .kd__faq summary::-webkit-details-marker { display: none; }
  .kd__faq summary::after { content: '+'; font-size: 1.5rem; font-weight: 400; color: var(--led-ink); transition: transform .2s; }
  .kd__faq details[open] summary::after { transform: rotate(45deg); }
  .kd__faq p { margin: 0 0 1.2rem; color: var(--mute); max-width: 56ch; }
  .kd__more { margin-top: clamp(4rem, 8vw, 7rem); }
  .kd__others { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .kd__others a { display: grid; gap: .6rem; text-decoration: none; font-weight: 800; }
  .kd__others a:hover span { color: var(--led-ink); }
  @media (max-width: 860px) {
    .kd__grid { grid-template-columns: 1fr; }
    .kd__cover { position: static; max-width: 480px; }
    .kd__others { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .kd__row { flex-direction: column; }
  }
</style>
