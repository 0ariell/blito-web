---
import { Image } from 'astro:assets';
import { img } from '../lib/img';
const fotos = [
  { f: 'bts-cabina.jpg', alt: 'Con gorra roja y campera Nike frente a una cabina de DJ con humo y luz azul.' },
  { f: 'bts-backstage.jpg', alt: 'Backstage de un rodaje: tres artistas posando frente al cartel de salida.' },
  { f: 'bts-ascensor.jpg', alt: 'Retrato en un ascensor antiguo de rejas celestes, con gorra roja.' },
  { f: 'bts-buzo-rojo.jpg', alt: 'Toma desde abajo: con anteojos y buzo rojo, sirviendo una bebida.' },
  { f: 'bts-pileta.jpg', alt: 'Sentado al borde de una pileta con remera roja de Ferrari.' },
];
---
<section id="backstage" class="sec gal" aria-labelledby="gal-t">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <h2 id="gal-t" class="sec-title">Detrás de escena</h2>
        <p class="sec-lead">Rodajes, sesiones y lo que pasa entre toma y toma.</p>
      </div>
      <div class="gal__nav">
        <button class="gal__btn" data-dir="-1" aria-controls="gal-track">
          <span class="visually-hidden">Fotos anteriores</span>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="gal__btn" data-dir="1" aria-controls="gal-track">
          <span class="visually-hidden">Fotos siguientes</span>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
  </div>
  <ul class="gal__track" id="gal-track" role="list" tabindex="0" aria-label="Fotos detrás de escena, desplazables">
    {fotos.map((p) => (
      <li class="gal__item">
        <Image src={img(p.f)} alt={p.alt} widths={[400, 640, 900]} sizes="(min-width: 900px) 30vw, 78vw" loading="lazy" />
      </li>
    ))}
  </ul>
</section>

<style>
  .gal { overflow: hidden; }
  .gal__nav { display: flex; gap: .5rem; }
  .gal__btn {
    display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; border: 0; cursor: pointer;
    background: transparent; box-shadow: inset 0 0 0 1px var(--line); color: #fff;
    transition: background-color .18s, box-shadow .18s, opacity .18s;
  }
  .gal__btn:hover { background: var(--panel); box-shadow: inset 0 0 0 1px var(--led-ink); }
  .gal__btn[disabled] { opacity: .35; cursor: default; }
  .gal__track {
    list-style: none; margin: 0; padding: 0 max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    display: grid; grid-auto-flow: column; grid-auto-columns: clamp(240px, 30vw, 440px); gap: clamp(.8rem, 1.6vw, 1.4rem);
    overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scroll-padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    scrollbar-width: none;
  }
  .gal__track::-webkit-scrollbar { display: none; }
  .gal__track:focus-visible { outline: 3px solid var(--led-ink); outline-offset: 6px; }
  .gal__item { scroll-snap-align: start; }
  .gal__item img { width: 100%; height: auto; aspect-ratio: 2 / 3; object-fit: cover; border-radius: 14px; }
  @media (max-width: 760px) {
    .gal__track { grid-auto-columns: 78vw; }
    .gal__nav { display: none; }
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>('#gal-track')!;
  const btns = document.querySelectorAll<HTMLButtonElement>('.gal__btn');
  const step = () => (track.querySelector('.gal__item') as HTMLElement).getBoundingClientRect().width + 20;
  btns.forEach((b) => b.addEventListener('click', () => {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    track.scrollBy({ left: Number(b.dataset.dir) * step(), behavior: reduce ? 'auto' : 'smooth' });
  }));
  const sync = () => {
    btns[0].disabled = track.scrollLeft < 4;
    btns[1].disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
  };
  track.addEventListener('scroll', sync, { passive: true });
  sync();
</script>
