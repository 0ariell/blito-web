---
import { contacto, waLink } from '../data/site';
---
<section id="demo" class="sec demo" aria-labelledby="demo-t">
  <div class="wrap demo__grid">
    <div>
      <h2 id="demo-t" class="demo__title">Mandá tu demo al sello</h2>
      <p class="demo__lead">¿Tenés un tema terminado y buscás sello? Mandalo. Escuchamos todo lo que llega y, si nos copa, te escribimos.</p><p class="demo__alt">Si lo que buscás es producir un tema, <a href="/produccion#contacto">contanos tu idea acá</a>.</p>
      <div class="direct">
        <p>O escribinos directo</p>
        <a href={waLink("Hola Blito, te quiero mandar un tema.")} target="_blank" rel="noopener">WhatsApp {contacto.whatsapp}</a>
        <a href={contacto.igSello} target="_blank" rel="noopener">Instagram @blitoproducciones</a>
        <a href={contacto.igBlito} target="_blank" rel="noopener">Instagram @blitormx</a>
      </div>
    </div>

    <form class="form" method="post" action="/api/demo" novalidate data-demo>
      <div class="field">
        <label for="f-nombre">Nombre o nombre artístico</label>
        <input id="f-nombre" name="nombre" autocomplete="name" required />
        <p class="field__err" id="e-nombre"></p>
      </div>
      <div class="field">
        <label for="f-contacto">Instagram, mail o WhatsApp</label>
        <input id="f-contacto" name="contacto" required autocomplete="off" spellcheck="false" placeholder="@tuusuario o tu mail…" />
        <p class="field__err" id="e-contacto"></p>
      </div>
      <div class="field">
        <label for="f-link">Link al tema</label>
        <input id="f-link" name="link" type="url" inputmode="url" required autocomplete="off" spellcheck="false" placeholder="https://drive.google.com/…" aria-describedby="h-link" />
        <p class="field__hint" id="h-link">Drive, SoundCloud o YouTube oculto. Que se pueda escuchar sin pedir acceso.</p>
        <p class="field__err" id="e-link"></p>
      </div>
      <div class="field">
        <label for="f-mensaje">Contanos algo <span class="opt">(opcional)</span></label>
        <textarea id="f-mensaje" name="mensaje" rows="4" placeholder="Qué buscás: beat, mezcla, sacar el tema por el sello…"></textarea>
      </div>
      <div class="hp" aria-hidden="true"><label>Web <input name="web" tabindex="-1" autocomplete="off" /></label></div>
      <button class="btn" type="submit">Enviar demo</button>
      <p class="form__status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<style>
  .demo { border-top: 1px solid var(--line); }
  .demo__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 6vw, 6rem); }
  .demo__title { margin: 0; font-size: clamp(3.2rem, 1rem + 7vw, 8rem); line-height: .86; font-weight: 900; font-family: var(--display); font-variation-settings: 'wdth' 125; letter-spacing: -0.04em; max-width: 8ch; }
  .demo__lead { font-size: var(--step-1); line-height: 1.3; max-width: 28ch; margin: 1.5rem 0 0; color: var(--mute); }
  .demo__alt { margin: 1rem 0 0; color: var(--mute); }
  .demo__alt a { color: var(--led-ink); }
  .direct { margin-top: 2.5rem; display: grid; gap: .2rem; justify-items: start; }
  .direct p { margin: 0 0 .4rem; font-weight: 700; color: var(--led-ink); }
  .direct a { font-weight: 500; text-underline-offset: .25em; padding-block: .35rem; }
  @media (max-width: 860px) { .demo__grid { grid-template-columns: 1fr; } }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-demo]')!;
  const status = form.querySelector<HTMLElement>('.form__status')!;
  const submit = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    form.querySelectorAll('.field__err').forEach((el) => (el.textContent = ''));
    form.querySelectorAll('[aria-invalid]').forEach((el) => { el.removeAttribute('aria-invalid'); });
    status.textContent = '';
    submit.disabled = true; submit.textContent = 'Enviando…';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      const data = await res.json();
      if (data.ok) { form.reset(); status.textContent = 'Demo enviada. Si nos copa, te escribimos.'; return; }
      let first: HTMLElement | null = null;
      for (const [k, msg] of Object.entries<string>(data.errors ?? {})) {
        document.getElementById(`e-${k}`)!.textContent = msg;
        const input = document.getElementById(`f-${k}`)!;
        input.setAttribute('aria-invalid', 'true');
        input.setAttribute('aria-errormessage', `e-${k}`);
        first ??= input;
      }
      first?.focus();
    } catch {
      status.textContent = 'No se pudo enviar. Revisá tu conexión y probá de nuevo, o escribinos por WhatsApp.';
    } finally {
      submit.disabled = false; submit.textContent = 'Enviar demo';
    }
  });
</script>
