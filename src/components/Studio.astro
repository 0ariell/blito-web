---
import { Image } from 'astro:assets';
import { servicios } from '../data/site';
import { img } from '../lib/img';
const fotos = [
  { f: 'ig-6.jpg', alt: 'Blito frente a la consola del estudio, con luces azules.' },
  { f: 'ig-7.jpg', alt: 'El estudio con paneles acústicos y monitores.' },
  { f: 'ig-4.jpg', alt: 'Blito en las bandejas, con luz roja.' },
  { f: 'ig-2.jpg', alt: 'Dos artistas posando en el estudio.' },
];
---
<section id="estudio" class="sec st" aria-labelledby="st-t">
  <div class="wrap st__grid">
    <div class="st__photos">
      {fotos.map((p) => <Image src={img(p.f)} alt={p.alt} widths={[192]} sizes="(min-width: 900px) 20vw, 45vw" loading="lazy" />)}
    </div>
    <div>
      <h2 id="st-t" class="sec-title">El estudio</h2>
      <p class="sec-lead">Todo lo que necesita un tema para salir, en un mismo lugar.</p>
      <dl class="svc">
        {servicios.map((s) => (<div><dt>{s.titulo}</dt><dd>{s.texto}</dd></div>))}
      </dl>
      <a href="#demo" class="btn st__cta">Reservar una sesión</a>
    </div>
  </div>
</section>

<style>
  .st__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .st__photos { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; max-width: 560px; }
  .st__photos img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 10px; }
  .st__photos img:nth-child(2n) { transform: translateY(2.5rem); }
  .svc { margin: 2rem 0 0; }
  .st__cta { margin-top: 2rem; }
  .svc > div { padding: 1.3rem 0; border-top: 1px solid var(--line); }
  .svc dt { font-size: var(--step-1); font-weight: 800; }
  .svc dd { margin: .35rem 0 0; color: var(--mute); max-width: 48ch; }
  @media (max-width: 860px) {
    .st__grid { grid-template-columns: 1fr; }
    .st__photos { margin-bottom: 2.5rem; }
  }
</style>
