---
import { Image } from 'astro:assets';
import { lanzamientos } from '../data/site';
import { img } from '../lib/img';
const ultimo = lanzamientos[0];
---
<section class="hero" aria-labelledby="hero-t">
  <div class="hero__glow" aria-hidden="true"></div>
  <h1 id="hero-t" class="hero__mark" aria-label="Blito Producciones" translate="no">
    <span aria-hidden="true">{'BLITO'.split('').map((l) => <span>{l}</span>)}</span>
  </h1>
  <div class="hero__figwrap">
  <Image
    src={img('blito-hero.png')}
    alt="Blito de noche, con gorro gris, anteojos y buzo negro."
    class="hero__fig"
    widths={[480, 760, 1007]}
    sizes="(min-width: 900px) 52vw, 96vw"
    format="webp"
    quality={86}
    loading="eager"
    decoding="sync"
    fetchpriority="high"
  />
  </div>

  <div class="wrap hero__content">
    <div class="hero__copy">
      <p class="hero__lead">Productora, sello y drum kits de Buenos Aires.</p>
      <p class="hero__sub">Beats, grabación, mezcla y lanzamientos para RKT, trap y turreo.</p>
      <div class="hero__actions">
        <a href="/produccion" class="btn btn--white">Producí con Blito</a>
        <a href="/kits" class="btn btn--ghost">Ver drum kits</a>
      </div>
    </div>
    <a class="now" href="#lanzamientos" data-play={ultimo.youtube} data-title={`${ultimo.tema}, ${ultimo.artistas}`}>
      <span class="now__dot" aria-hidden="true"></span>
      <span><span class="now__k">Escuchá lo último</span><strong>{ultimo.tema}</strong>{ultimo.artistas}</span>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative; min-height: max(100svh, 640px); overflow: hidden; isolation: isolate;
    display: grid; grid-template-rows: 1fr auto;
  }
  /* Resplandor de las tiras LED del estudio, detrás de la figura. */
  .hero__glow {
    position: absolute; z-index: -2; pointer-events: none;
    left: 50%; top: 52%; width: min(120vw, 1500px); aspect-ratio: 1.15; translate: -30% -50%;
    background:
      radial-gradient(closest-side, rgba(110, 116, 255, .55), rgba(43, 48, 242, .38) 38%, rgba(43, 48, 242, .12) 62%, transparent 76%);
    filter: blur(8px);
    animation: glow 7s ease-in-out infinite alternate;
  }
  @keyframes glow { from { opacity: .82; scale: .97; } to { opacity: 1; scale: 1.03; } }

  .hero__mark {
    position: absolute; z-index: -1; left: 0; right: 0; top: clamp(150px, 26vh, 260px); margin: 0;
    padding-inline: max(var(--gutter), env(safe-area-inset-left));
    font-family: var(--display); font-variation-settings: 'wdth' 150; font-weight: 900;
    font-size: clamp(4rem, 19.4vw, 19rem); line-height: .8; letter-spacing: -0.04em;
    color: #fff;
  }
  .hero__mark > span { display: flex; justify-content: space-between; clip-path: inset(-1em -1em 0 -1em); }
  .hero__mark > span > span { display: block; animation: rise 1s var(--ease) both; }
  .hero__mark > span > span:nth-child(2) { animation-delay: 60ms; }
  .hero__mark > span > span:nth-child(3) { animation-delay: 120ms; }
  .hero__mark > span > span:nth-child(4) { animation-delay: 180ms; }
  .hero__mark > span > span:nth-child(5) { animation-delay: 240ms; }
  @keyframes rise { from { transform: translateY(105%); } }

  /* El resplandor va en el contenedor: así el fundido inferior de la foto no lo recorta. */
  .hero__figwrap {
    position: absolute; z-index: 0; bottom: 0; right: max(2vw, calc((100vw - var(--max)) / 2));
    filter: drop-shadow(0 0 34px rgba(43, 48, 242, .6)) drop-shadow(0 0 1.5px rgba(138, 143, 255, .55));
    animation: fig-in 1.1s var(--ease) both .15s;
  }
  .hero__fig {
    display: block; height: min(96svh, 1100px); width: auto; max-width: 62vw; object-fit: contain;
    -webkit-mask-image: linear-gradient(to top, transparent 0%, #000 22%);
    mask-image: linear-gradient(to top, transparent 0%, #000 22%);
  }
  @keyframes fig-in { from { opacity: 0; translate: 0 24px; } }

  .hero__content {
    grid-row: 2; position: relative; z-index: 1;
    display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1.5rem 2rem;
    padding-bottom: clamp(1.5rem, 4vw, 3rem);
  }
  .hero__copy { max-width: 34rem; }
  .hero__lead { margin: 0; font-family: var(--display); font-variation-settings: 'wdth' 110; font-weight: 800; font-size: var(--step-2); line-height: 1.02; letter-spacing: -0.02em; }
  .hero__sub { margin: .7rem 0 0; color: var(--mute); max-width: 36ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.4rem; }

  .now {
    display: flex; gap: .9rem; align-items: flex-start; max-width: 32ch; padding: 1rem 1.2rem;
    border-radius: 14px; background: rgba(0,0,0,.55); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    box-shadow: inset 0 0 0 1px var(--line); text-decoration: none; font-size: var(--step--1); line-height: 1.4; color: var(--mute);
    transition: box-shadow .2s;
  }
  .now:hover { box-shadow: inset 0 0 0 1px var(--led-ink); }
  .now strong { display: block; color: #fff; font-size: var(--step-0); }
  .now__k { display: block; color: var(--led-ink); font-weight: 600; }
  .now__dot { flex: none; width: .65rem; height: .65rem; margin-top: .3rem; border-radius: 50%; background: var(--rec); box-shadow: 0 0 0 4px rgba(255,59,47,.22); }

  /* Celular: todo apilado. Marca arriba, Blito delante de la marca, textos abajo. */
  @media (max-width: 860px) {
    .hero { display: block; min-height: 0; padding-top: 92px; }
    .hero__mark { position: relative; top: auto; font-size: 20.6vw; }
    .hero__figwrap { position: relative; right: auto; bottom: auto; margin: -15vw auto 0; width: min(84vw, 460px); }
    .hero__fig { width: 100%; height: auto; max-width: none; }
    .hero__glow { top: 34%; translate: -50% -50%; width: 160vw; }
    .hero__content { margin-top: -18vw; padding-top: 0; }
    .now { flex: 1 1 100%; max-width: none; }
  }
  @media (prefers-reduced-motion: reduce) { .hero__glow { animation: none; } }
</style>
