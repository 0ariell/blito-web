---
const links = [
  { href: '/#lanzamientos', label: 'Lanzamientos' },
  { href: '/#blito', label: 'Blito' },
  { href: '/kits', label: 'Drum kits' },
  { href: '/#artistas', label: 'Artistas' },
  { href: '/#estudio', label: 'Estudio' },
];
---
<header class="hd" data-hd>
  <div class="wrap hd__in">
    <a href="/" class="hd__logo" aria-label="Blito Producciones, inicio">
      <img src="/logo-bp.png" width="40" height="40" alt="" />
      <span>Blito Producciones</span>
    </a>
    <nav class="hd__nav" id="menu" aria-label="Principal">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href="/#demo" class="btn hd__cta">Mandá tu demo</a>
    </nav>
    <button class="hd__toggle" aria-expanded="false" aria-controls="menu">
      <span class="visually-hidden">Menú</span>
      <span class="hd__bars" aria-hidden="true"></span>
    </button>
  </div>
</header>

<style>
  .hd { position: fixed; inset: 0 0 auto; z-index: 40; padding-top: env(safe-area-inset-top); transition: background-color .25s, box-shadow .25s; }
  .hd.is-solid { background: rgba(0,0,0,.82); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); box-shadow: 0 1px 0 var(--line); }
  .hd__in { display: flex; align-items: center; gap: 2rem; min-height: 72px; }
  .hd__logo { display: flex; align-items: center; gap: .7rem; text-decoration: none; font-weight: 700; font-variation-settings: 'wdth' 112; }
  .hd__logo img { border-radius: 50%; box-shadow: 0 0 0 1px var(--line); }
  .hd__nav { display: flex; align-items: center; gap: 1.8rem; margin-left: auto; }
  .hd__nav a:not(.btn) { text-decoration: none; font-weight: 500; padding-block: .6rem; }
  .hd__nav a:not(.btn):hover { color: var(--led-ink); }
  .hd__cta { min-height: 42px; font-size: var(--step--1); }
  .hd__toggle { display: none; }

  @media (max-width: 860px) {
    .hd__logo span { display: none; }
    .hd__toggle {
      display: grid; place-items: center; margin-left: auto; width: 48px; height: 48px;
      background: none; border: 0; cursor: pointer;
    }
    .hd__bars, .hd__bars::before, .hd__bars::after { display: block; width: 24px; height: 2px; background: #fff; transition: transform .2s; }
    .hd__bars { position: relative; }
    .hd__bars::before, .hd__bars::after { content: ''; position: absolute; left: 0; }
    .hd__bars::before { top: -7px; } .hd__bars::after { top: 7px; }
    [aria-expanded='true'] .hd__bars { background: transparent; }
    [aria-expanded='true'] .hd__bars::before { transform: translateY(7px) rotate(45deg); }
    [aria-expanded='true'] .hd__bars::after { transform: translateY(-7px) rotate(-45deg); }
    .hd__nav {
      position: fixed; inset: 72px 0 auto; flex-direction: column; align-items: stretch; gap: 0;
      background: #000; padding: .5rem var(--gutter) 1.5rem; border-bottom: 1px solid var(--line); overscroll-behavior: contain; max-height: calc(100svh - 72px); overflow-y: auto;
      visibility: hidden; opacity: 0; transform: translateY(-8px); transition: opacity .2s, transform .2s, visibility .2s;
    }
    .hd__nav.is-open { visibility: visible; opacity: 1; transform: none; }
    .hd__nav a:not(.btn) { font-size: var(--step-1); font-weight: 700; padding-block: .9rem; border-bottom: 1px solid var(--line); }
    .hd__cta { margin-top: 1.2rem; min-height: 52px; font-size: var(--step-0); }
    .hd.menu-open { background: #000; }
  }
</style>

<script>
  const hd = document.querySelector<HTMLElement>('[data-hd]')!;
  const solid = () => hd.classList.toggle('is-solid', scrollY > 40);
  solid();
  addEventListener('scroll', solid, { passive: true });

  const toggle = hd.querySelector<HTMLButtonElement>('.hd__toggle')!;
  const nav = hd.querySelector<HTMLElement>('.hd__nav')!;
  const set = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    nav.classList.toggle('is-open', open);
    hd.classList.toggle('menu-open', open);
  };
  toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
  nav.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) set(false); });
  addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
</script>
