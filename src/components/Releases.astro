---
import { Image } from 'astro:assets';
import { lanzamientos, contacto } from '../data/site';
import { img } from '../lib/img';
const filtros = [
  { id: 'todo', label: 'Todo' },
  { id: 'produccion', label: 'Producciones' },
  { id: 'remix', label: 'Remixes y edits' },
];
---
<section id="lanzamientos" class="sec rel" aria-labelledby="rel-t">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <h2 id="rel-t" class="sec-title">Lanzamientos</h2>
        <p class="sec-lead">Lo que salió del estudio. Tocá una portada para escucharlo acá.</p>
      </div>
      <div class="chips" role="group" aria-label="Filtrar lanzamientos">
        {filtros.map((f, i) => (
          <button class="chip" data-filter={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>
        ))}
      </div>
    </div>

    <ul class="grid" role="list">
      {lanzamientos.map((l, i) => {
        const square = l.img.startsWith('cover-');
        return (
          <li class:list={['card', { 'card--lead': i === 0 }]} data-tipo={l.tipo}>
            <button
              class="card__btn"
              data-play={l.youtube}
              data-spotify={l.spotify}
              data-title={`${l.tema}, ${l.artistas}`}
            >
              <span class="card__media">
                <Image
                  src={img(l.img)}
                  alt=""
                  widths={i === 0 ? [640, 1280] : [400, 640]}
                  sizes={i === 0 ? '(min-width: 900px) 50vw, 100vw' : '(min-width: 900px) 25vw, 50vw'}
                  class:list={[{ 'is-square': square }]}
                  loading={i < 2 ? 'eager' : 'lazy'}
                />
                <span class="card__play" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
                </span>
              </span>
              <span class="card__txt">
                <span class="card__tema" translate="no">{l.tema}</span>
                <span class="card__meta">{l.artistas}</span>
                <span class="card__src">{l.spotify ? 'Escuchar en Spotify' : 'Ver video'}{l.anio && `, ${l.anio}`}</span>
              </span>
            </button>
          </li>
        );
      })}
      <li class="card card--more" data-tipo="todo">
        <a href={contacto.youtube} class="more" target="_blank" rel="noopener">
          <span class="more__t">Más videos en YouTube</span>
          <span class="more__s">Remixes, turreo edits y sesiones del estudio.</span>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .chips { display: flex; flex-wrap: wrap; gap: .5rem; }
  .chip {
    min-height: 44px; padding: 0 1.1rem; border-radius: 999px; border: 0; cursor: pointer;
    background: transparent; box-shadow: inset 0 0 0 1px var(--line); color: var(--mute); font-weight: 600;
    transition: background-color .18s, color .18s, box-shadow .18s;
  }
  .chip:hover { color: #fff; box-shadow: inset 0 0 0 1px var(--led-ink); }
  .chip[aria-pressed='true'] { background: var(--led); color: #fff; box-shadow: none; }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(.8rem, 1.6vw, 1.4rem); }
  .card[hidden] { display: none; }
  .card--lead { grid-column: span 2; grid-row: span 2; }
  .card__btn { all: unset; display: block; width: 100%; cursor: pointer; border-radius: 12px; }
  .card__btn:focus-visible { outline: 3px solid var(--led-ink); outline-offset: 4px; }
  .card__media { position: relative; display: block; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 12px; background: #0a0a14; }
  .card--lead .card__media { aspect-ratio: 16 / 11; }
  .card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s var(--ease), filter .3s; }
  .card__media img.is-square { object-fit: contain; background: #000; }
  .card__btn:hover .card__media img { transform: scale(1.04); }
  .card__play {
    position: absolute; right: .8rem; bottom: .8rem; display: grid; place-items: center;
    width: 48px; height: 48px; border-radius: 50%; background: var(--led); color: #fff;
    box-shadow: 0 6px 24px rgba(43,48,242,.6); transform: scale(.9); opacity: .92; transition: transform .2s var(--ease), opacity .2s;
  }
  .card--lead .card__play { width: 64px; height: 64px; }
  .card__btn:hover .card__play, .card__btn:focus-visible .card__play { transform: none; opacity: 1; }
  .card__txt { display: grid; gap: .15rem; padding-top: .8rem; }
  .card__tema { font-weight: 800; font-size: var(--step-0); line-height: 1.15; font-variation-settings: 'wdth' 88; }
  .card--lead .card__tema { font-size: var(--step-2); line-height: 1; font-weight: 900; font-family: var(--display); font-variation-settings: 'wdth' 62; }
  .card__meta { color: var(--mute); font-size: var(--step--1); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .card__src { color: var(--led-ink); font-size: var(--step--1); font-weight: 600; }

  .card--more { display: flex; }
  .more {
    flex: 1; display: grid; align-content: end; gap: .4rem; padding: 1.4rem; min-height: 180px; min-width: 0;
    border-radius: 12px; text-decoration: none; background: var(--led);
    background-image: radial-gradient(120% 100% at 100% 0%, rgba(255,255,255,.22), transparent 55%);
    transition: filter .2s;
  }
  .more:hover { filter: brightness(1.12); }
  .more__t { font-size: var(--step-1); line-height: 1.05; font-weight: 900; font-variation-settings: 'wdth' 112; }
  .more__s { font-size: var(--step--1); color: rgba(255,255,255,.85); }
  @media (max-width: 900px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 520px) {
    .card__play { width: 44px; height: 44px; right: .5rem; bottom: .5rem; }
  }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const cards = document.querySelectorAll<HTMLElement>('.card');
  const aplicar = (f: string) => {
    chips.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.filter === f)));
    cards.forEach((card, i) => {
      card.hidden = card.dataset.tipo === 'todo' ? f !== 'todo' : f !== 'todo' && card.dataset.tipo !== f;
      // la tarjeta grande solo tiene sentido en "Todo"
      card.classList.toggle('card--lead', i === 0 && f === 'todo');
    });
  };
  // El filtro queda en la URL (?filtro=remix) para poder compartirlo.
  chips.forEach((c) => c.addEventListener('click', () => {
    const f = c.dataset.filter!;
    aplicar(f);
    const u = new URL(location.href);
    f === 'todo' ? u.searchParams.delete('filtro') : u.searchParams.set('filtro', f);
    history.replaceState(null, '', u);
  }));
  const inicial = new URL(location.href).searchParams.get('filtro');
  if (inicial && [...chips].some((c) => c.dataset.filter === inicial)) aplicar(inicial);
</script>
